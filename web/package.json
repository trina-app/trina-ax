{
  "name": "@mycel/web",
  "version": "0.2.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Web client (React + Vite). Component D. Built to web/dist and served by the team server.",
  "scripts": {
    "dev": "vite --port 19140 --strictPort",
    "build": "vite build && bun scripts/build-vendor.ts",
    "build:app": "vite build",
    "build:vendor": "bun scripts/build-vendor.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test test/unit",
    "e2e": "bunx playwright test -c playwright.config.ts",
    "mock": "bun test/mock/serve.ts"
  },
  "dependencies": {
    "@mycel/shared": "workspace:*",
