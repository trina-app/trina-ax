    "katex": "0.19.0",
    "lucide-react": "1.54.0",
    "mermaid": "11.17.2",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.3.289",
    "pptx-preview": "1.0.7",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-pdf": "11.0.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "rehype-katex": "7.0.1",
    "remark-cjk-friendly": "2.3.2",
