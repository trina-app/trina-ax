# /etc/mycel-relay/relay.env (root 0644). The relay reads RELAY_* (relay/README.md has the full list).
RELAY_DOMAIN=treesoop.com
# the relay's Tailscale address: operator API /ops/v1 and /metrics (Tailscale ACL: tag:cp -> tag:relay:8090 only)
RELAY_PRIVATE_LISTEN=100.64.0.10:8090
RELAY_OPERATOR_KEYS_FILE=/etc/mycel-relay/operator-keys.json
# production: no public self-registration; cloud teams through the operator API, the add-on with claim codes
RELAY_OPEN_REGISTRATION=0
RELAY_GRACE_MS=10000
RELAY_ACCOUNT_HOST=account.treesoop.com
RELAY_STATUS_HOST=status.treesoop.com
