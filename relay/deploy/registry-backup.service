[Unit]
Description=Daily encrypted copy of the relay registry to R2
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# relay-checkin: Sentry monitor relay-registry-backup when RELAY_SENTRY_DSN is set (README.md)
ExecStart=/usr/local/sbin/relay-checkin relay-registry-backup "40 18 * * *" 30 30 -- /opt/mycel-relay/current/deploy/registry-backup.sh
