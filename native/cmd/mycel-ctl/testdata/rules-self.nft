table inet mycel {}
delete table inet mycel
table inet mycel {
  chain output {
    type filter hook output priority filter; policy accept;
    meta skuid 990 jump engine_out
    meta skuid 989 jump server_out
  }
  chain engine_out {
    oifname "lo" ip daddr 127.0.0.1 tcp dport 47821 accept
    meta l4proto tcp counter reject with tcp reset
    counter reject with icmpx type admin-prohibited
  }
  chain server_out {
    ip daddr 169.254.0.0/16 counter reject with icmpx type admin-prohibited
  }
}
