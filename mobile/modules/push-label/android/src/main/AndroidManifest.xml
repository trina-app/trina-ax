<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- FCM's entry point for this app (expo-notifications' own service is removed by plugins/push-label.js) -->
    <service
      android:name="expo.modules.pushlabel.LabelMessagingService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
