{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "base": { "env": { "MYCEL_MOBILE_EDITION": "trina" } },
    "development": { "extends": "base", "distribution": "internal", "ios": { "simulator": true } },
    "preview": { "extends": "base", "distribution": "internal" },
    "production": { "extends": "base", "env": { "MYCEL_MOBILE_EDITION": "trina", "MYCEL_MOBILE_BUILD_NUMBER": "1" } }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "ASC_APP_ID_PLACEHOLDER", "appleTeamId": "YWW96288YY" },
      "android": { "serviceAccountKeyPath": "PLAY_SERVICE_ACCOUNT_JSON_PLACEHOLDER", "track": "internal" }
    }
  }
}
