{
  "name": "mycel",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "shared",
    "server",
    "web",
    "desktop",
    "relay",
    "tests"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun --watch server/src/main.ts",
    "start:server": "bun server/src/main.ts",
    "build": "bash native/build.sh && bun run --cwd web build",
    "admin": "bun server/src/auth/cli.ts",
    "build:native": "bash native/build.sh",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit && bun run --cwd web typecheck && bun run --cwd desktop typecheck",
    "test": "bun run scripts/test-all.ts",
    "test:unit": "bun test tests/unit",
    "test:stage1": "bun run tests/stage1.ts",
    "test:stage1:fast": "bun run tests/stage1.ts --no-claude --no-docker",
    "test:fuzz:fast": "bun run tests/fuzz/run-fast.ts",
    "test:b:e2e": "bun run tests/e2e/b-chat-e2e.ts",
    "dev:relay": "node --disable-warning=ExperimentalWarning relay/src/main.ts --dev",
    "dev:server:relay": "MYCEL_RELAY_URL=ws://127.0.0.1:19161/connect bun --watch server/src/main.ts",
    "test:relay": "bun test tests/relay",
    "build:bundle": "bun scripts/build-bundle.ts",
    "build:menubar": "bash menubar/build.sh",
    "dev:web": "bun run --cwd web dev",
    "build:web": "bun run --cwd web build",
    "test:web": "bun run --cwd web test",
    "typecheck:web": "bun run --cwd web typecheck",
    "e2e:web": "bun run --cwd web build && bun run --cwd web e2e",
    "test:desktop:e2e": "bun run --cwd desktop test:e2e",
    "test:fast": "bun run scripts/test-all.ts --no-relay"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "@types/node": "26.6.5",
    "typescript": "5.9.3"
  }
}
