<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Developer ID build (the dmg, electron-builder.devid.config.ts): the app itself, hardened runtime, no App Sandbox.
     JIT: Electron's JavaScript engine. Microphone: voice input in chats. Nothing else is opened up. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
