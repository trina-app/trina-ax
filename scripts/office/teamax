#!/bin/bash
# Team AX office mode control command (docs/OFFICE.md). Installed as <home>/app/teamax, linked from <home>/teamax.
#
#   ~/TeamAX/teamax status | start | stop | restart | logs [n] | info | card | setup-link
#   ~/TeamAX/teamax reset-link [--username U]     one-time password reset link
#   ~/TeamAX/teamax backup                        a backup now (on this Mac's disk, like the nightly one)
#   ~/TeamAX/teamax archive [--out] <file>        encrypted copy for an external disk (asks for a password)
#   ~/TeamAX/teamax restore-archive [--in] <file> [--replace]
#   ~/TeamAX/teamax public-address set <app.example.com> <token file> | off | status
#                                                 the internet address (Cloudflare Tunnel, docs/OFFICE.md)
set -euo pipefail
d=$(cd "$(dirname "$0")" && pwd)
if [ -d "$d/app/server" ]; then H=$d; else H=$(dirname "$d"); fi
BUN="$H/app/bin/bun"
JS="$H/app/server/src/office.js"
[ -x "$BUN" ] && [ -f "$JS" ] || { echo "teamax: $H/app is incomplete; run office-install.sh again" >&2; exit 1; }
cmd=${1:-status}; [ $# -gt 0 ] && shift

# archive / restore-archive take the file either alone or after --out / --in (the form `teamax` prints in its usage)
file_arg() { # $1 = flag name; prints the file, the rest of the arguments follow on later lines
  local flag=$1; shift
  local f="" rest=()
  while [ $# -gt 0 ]; do
    case "$1" in
      "$flag") [ $# -ge 2 ] || { echo "teamax: $flag needs a file" >&2; exit 2; }; f=$2; shift 2 ;;
      --*) rest+=("$1"); shift ;;
      *) if [ -z "$f" ]; then f=$1; else rest+=("$1"); fi; shift ;;
    esac
  done
  printf '%s\n' "$f" ${rest[@]+"${rest[@]}"}
}

case "$cmd" in
  archive)
    out=$(file_arg --out "$@" | head -n 1)
    [ -n "$out" ] || { echo "usage: teamax archive <file on the external disk>" >&2; exit 2; }
    read -r -s -p "암호 (8자 이상) / password (8+ characters): " pw; echo
    read -r -s -p "한 번 더 / again: " pw2; echo
    [ "$pw" = "$pw2" ] || { echo "teamax: the two passwords differ" >&2; exit 2; }
    printf '%s' "$pw" | exec "$BUN" "$JS" archive --home "$H" --out "$out" ;;
  restore-archive)
    mapfile_lines=$(file_arg --in "$@")
    in=$(printf '%s\n' "$mapfile_lines" | head -n 1)
    [ -n "$in" ] || { echo "usage: teamax restore-archive <file> [--replace]" >&2; exit 2; }
    extra=()
    while IFS= read -r l; do [ -n "$l" ] && extra+=("$l"); done < <(printf '%s\n' "$mapfile_lines" | tail -n +2)
    read -r -s -p "보관본 암호 / archive password: " pw; echo
    printf '%s' "$pw" | exec "$BUN" "$JS" restore-archive --home "$H" --in "$in" ${extra[@]+"${extra[@]}"} ;;
  *)
    exec "$BUN" "$JS" "$cmd" --home "$H" "$@" ;;
esac
