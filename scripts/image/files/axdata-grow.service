# Team AX: grow the data filesystem to the size of its disk each time the data disk is mounted. EC2 grows a volume
# while the instance is stopped (resizeTenant), so the bigger disk shows up at boot as an "add" event, and
# 90-axdata-resize.rules reacts only to "change" (an online grow). resize2fs does nothing when the size is the same.
# Pulled in by var-lib-mycel.mount (WantedBy), so it never waits for a data disk that does not exist yet (first boot).
[Unit]
Description=Team AX: grow the data filesystem to its disk size
After=var-lib-mycel.mount
Requires=var-lib-mycel.mount
ConditionPathIsMountPoint=/var/lib/mycel

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'exec /usr/sbin/resize2fs "$(/usr/bin/findmnt -n -o SOURCE --target /var/lib/mycel)"'
TimeoutStartSec=30min

[Install]
WantedBy=var-lib-mycel.mount
