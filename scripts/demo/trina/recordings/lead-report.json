    "content": "<!doctype html>\n<html lang=\"ko\"><head><meta charset=\"utf-8\">\n<style>\nbody{font-family:-apple-system,\"Apple SD Gothic Neo\",\"Malgun Gothic\",sans-serif;margin:24px;color:#222;background:#fafafa}\nh1{font-size:20px;margin:0 0 4px}\n.sub{color:#777;font-size:13px;margin-bottom:20px}\n.kpis{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:20px}\n.kpi{background:#fff;border:1px solid #e5e5e5;border-radius:10px;padding:12px 16px;min-width:140px}\n.kpi b{display:block;font-size:20px;margin-top:4px}\n.kpi span{font-size:12px;color:#777}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(420px,1fr));gap:16px}\n.card{background:#fff;border:1px solid #e5e5e5;border-radius:10px;padding:16px}\n.card h2{font-size:15px;margin:0 0 8px}\n.legend{font-size:12px;color:#555;margin-bottom:6px}\n.legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin:0 4px 0 10px;vertical-align:middle}\nsvg text{font-size:11px;fill:#444}\n.note{font-size:12px;color:#777;margin-top:16px;line-height:1.6}\n</style></head><body>\n<h1>10월 채널별 성과</h1>\n<div class=\"sub\">2026년 10월 1일 ~ 31일 · 원본: 마케팅팀/성과/2026-10-채널별-성과.xlsx</div>\n\n<div class=\"kpis\">\n  <div class=\"kpi\"><span>체험 신청 (목표 78)</span><b>80건 · 102.6%</b></div>\n  <div class=\"kpi\"><span>광고비 합계</span><b>6,420,000원</b></div>\n  <div class=\"kpi\"><span>신청당 비용 (전체)</span><b>80,250원</b></div>\n  <div class=\"kpi\"><span>클릭률 (전체)</span><b>2.09%</b></div>\n</div>\n\n<div class=\"grid\">\n  <div class=\"card\"><h2>채널별 체험 신청: 목표 대비 실적</h2>\n    <div class=\"legend\"><i style=\"background:#cfd8e3\"></i>목표<i style=\"background:#3b6fb6\"></i>실적</div>\n    <svg id=\"c1\" width=\"100%\" viewBox=\"0 0 440 260\"></svg></div>\n  <div class=\"card\"><h2>채널별 신청당 비용 (원)</h2>\n    <div class=\"legend\">블로그는 광고비 없음</div>\n    <svg id=\"c2\" width=\"100%\" viewBox=\"0 0 440 260\"></svg></div>\n  <div class=\"card\"><h2>주차별 체험 신청 (채널 누적)</h2>\n    <div class=\"legend\" id=\"lg3\"></div>\n    <svg id=\"c3\" width=\"100%\" viewBox=\"0 0 440 260\"></svg></div>\n  <div class=\"card\"><h2>주차별 광고비 (원)</h2>\n    <div class=\"legend\" id=\"lg4\"></div>\n    <svg id=\"c4\" width=\"100%\" viewBox=\"0 0 440 260\"></svg></div>\n</div>\n\n<div class=\"note\">\n· 카카오 배너는 11월 캠페인 전 테스트로 10/26(월)부터 1주만 집행했어요 (목표 3건 중 1건).<br>\n· 체험 신청은 랜딩 페이지 신청서의 유입 채널 기준, 광고비는 10월 31일 마감 기준 광고 관리 화면 집계예요.\n</div>\n\n<script>\nconst NS=\"http://www.w3.org/2000/svg\";\nconst fmt=n=>n.toLocaleString(\"ko-KR\");\nfunction el(svg,tag,a,txt){const e=document.createElementNS(NS,tag);for(const k in a)e.setAttribute(k,a[k]);if(txt!==undefined)e.textContent=txt;svg.appendChild(e);return e;}\nconst channels=[\"인스타그램\",\"네이버 검색광고\",\"카카오 배너\",\"블로그\"];\nconst colors=[\"#e1306c\",\"#03a94f\",\"#f2c200\",\"#7a7a7a\"];\nconst weeks=[\"1주\",\"2주\",\"3주\",\"4주\",\"5주\"];\nconst goal=[25,38,3,12], actual=[22,40,1,17];\nconst cpa=[109091,95500,200000,null];\nconst weekly={apply:[[2,5,5,6,4],[4,9,9,10,8],[0,0,0,0,1],[2,4,4,4,3]],\n              spend:[[280000,520000,540000,560000,500000],[440000,860000,880000,920000,720000],[0,0,0,0,200000],[0,0,0,0,0]]};\nconst L=50,R=430,T=20,B=220;\n\nfunction axis(svg,max,step,f){\n  for(let v=0;v<=max;v+=step){const y=B-(v/max)*(B-T);\n    el(svg,\"line\",{x1:L,x2:R,y1:y,y2:y,stroke:\"#eee\"});\n    el(svg,\"text\",{x:L-6,y:y+4,\"text-anchor\":\"end\"},f?f(v):v);}\n}\n\n// 1. 목표 vs 실적\n(function(){const s=document.getElementById(\"c1\"),max=45;axis(s,max,5);\n  const gw=(R-L)/4;\n  channels.forEach((c,i)=>{const x=L+gw*i+gw*0.15,w=gw*0.33;\n    const hg=goal[i]/max*(B-T),ha=actual[i]/max*(B-T);\n    el(s,\"rect\",{x:x,y:B-hg,width:w,height:hg,fill:\"#cfd8e3\"});\n    el(s,\"rect\",{x:x+w+2,y:B-ha,width:w,height:ha,fill:\"#3b6fb6\"});\n    el(s,\"text\",{x:x+w/2,y:B-hg-4,\"text-anchor\":\"middle\"},goal[i]);\n    el(s,\"text\",{x:x+w*1.5+2,y:B-ha-4,\"text-anchor\":\"middle\",\"font-weight\":\"bold\"},actual[i]);\n    el(s,\"text\",{x:L+gw*i+gw/2,y:B+16,\"text-anchor\":\"middle\"},c);\n    el(s,\"text\",{x:L+gw*i+gw/2,y:B+32,\"text-anchor\":\"middle\",fill:actual[i]>=goal[i]?\"#03873f\":\"#c0392b\"},Math.round(actual[i]/goal[i]*1000)/10+\"%\");\n  });})();\n\n// 2. 신청당 비용\n(function(){const s=document.getElementById(\"c2\"),max=200000;axis(s,max,50000,v=>v/10000+\"만\");\n  const gw=(R-L)/4;\n  channels.forEach((c,i)=>{const x=L+gw*i+gw*0.2,w=gw*0.6;\n    if(cpa[i]!==null){const h=cpa[i]/max*(B-T);\n      el(s,\"rect\",{x:x,y:B-h,width:w,height:h,fill:colors[i]});\n      el(s,\"text\",{x:x+w/2,y:B-h-4,\"text-anchor\":\"middle\"},fmt(cpa[i]));}\n    else el(s,\"text\",{x:x+w/2,y:B-6,\"text-anchor\":\"middle\",fill:\"#999\"},\"광고비 없음\");\n    el(s,\"text\",{x:L+gw*i+gw/2,y:B+16,\"text-anchor\":\"middle\"},c);\n  });})();\n\n// 3,4. 주차별 누적 막대\nfunction stacked(id,lgId,data,max,step,f,totF){\n  const s=document.getElementById(id);axis(s,max,step,f);\n  document.getElementById(lgId).innerHTML=channels.map((c,i)=>`<i style=\"background:${colors[i]}\"></i>${c}`).join(\"\");\n  const gw=(R-L)/5;\n  weeks.forEach((wk,j)=>{let acc=0;const x=L+gw*j+gw*0.2,w=gw*0.6;\n    channels.forEach((c,i)=>{const v=data[i][j];if(!v)return;const h=v/max*(B-T);\n      el(s,\"rect\",{x:x,y:B-acc-h,width:w,height:h,fill:colors[i]});acc+=h;});\n    const tot=data.reduce((a,r)=>a+r[j],0);\n    el(s,\"text\",{x:x+w/2,y:B-acc-4,\"text-anchor\":\"middle\",\"font-weight\":\"bold\"},totF(tot));\n    el(s,\"text\",{x:x+w/2,y:B+16,\"text-anchor\":\"middle\"},wk);\n  });\n}\nstacked(\"c3\",\"lg3\",weekly.apply,25,5,null,v=>v+\"건\");\nstacked(\"c4\",\"lg4\",weekly.spend,1600000,400000,v=>v/10000+\"만\",v=>fmt(v));\n</script>\n</body></html>\n"
   },
   "ok": true,
   "ms": 10
  },
