;; Team AX engine sandbox (design tab 2 "기본 ② 샌드박스", tab 6 root/engine.sb).
;; The launcher starts every engine turn as:
;;   sandbox-exec -f engine.sb -D CHAT_DIR=<agent>/<chatId> -D AGENT_ROOT=<agent> -D ENGINE_DIR=<dir of engine>
;;                -D BRIDGE=<mycel-bridge> -D TOOLS_SOCK=<run/tools/tools.sock> -D PROXY_PORT=<port>
;;                -D LOCAL_LOGIN=0|1 -D USER_HOME=<home of the account running the engine> <engine> ...
;; Allowed: the turn's chat folder (HOME, TMPDIR, CLAUDE_CONFIG_DIR, CODEX_HOME live in it), the engine and bridge
;; executables, system libraries, our tools socket, the local model proxy port.
;; Denied: everything else, in particular /tmp, /private/var/tmp, /Users, /Volumes, other chat folders. That includes
;; METADATA (stat/lstat/readlink: existence, size, mtime, mode): only the turn's own paths and the folders above them can
;; be stat()ed (security audit r1, os-layer #1). The kernel resolves a path before the sandbox sees it, so a name that
;; does not exist still answers ENOENT rather than EPERM: only an exactly guessed name can be tested for existence.
;; LOCAL_LOGIN=1 (dev / owner's own subscription login, engine runs as the owner): additionally the owner's
;; ~/.claude, ~/.claude.json, the installed Claude Code / Codex, the login keychain (Security framework) and direct
;; HTTPS to the vendor (there is no model proxy in this mode).
;; SBPL applies the LAST matching rule, so the broad denies come first and the narrow allows after them.
(version 1)
(deny default)
(import "system.sb")

;; --- processes -------------------------------------------------------------------------------------------------
(allow process-fork)
(allow process-exec
  (subpath (param "ENGINE_DIR"))
  (literal (param "BRIDGE")))
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow process-info-pidinfo process-info-setcontrol (target self))
;; system information (CPU count, OS version, memory ...) yes; the list of every process on the Mac no: it showed
;; other turns' engines (and with their pids, KERN_PROCARGS2 their argv, which the sandbox cannot filter: the kernel
;; only checks the uid). Single pids (kern.proc.pid) stay: runtimes ask about themselves.
(allow sysctl-read)
(deny sysctl-read
  (sysctl-name "kern.proc.all") (sysctl-name "kern.proc.pgrp") (sysctl-name "kern.proc.session")
  (sysctl-name "kern.proc.tty") (sysctl-name "kern.proc.uid") (sysctl-name "kern.proc.ruid")
  (sysctl-name "kern.proc.lcid"))

;; --- files -------------------------------------------------------------------------------------------------------
;; system libraries, frameworks, dyld cache, certificates, time zones, locale
(allow file-read*
  (subpath "/usr/lib") (subpath "/usr/share") (subpath "/System") (subpath "/Library/Apple")
  (subpath "/private/var/db/timezone") (subpath "/private/var/db/dyld") (subpath "/Library/Preferences/Logging")
  (literal "/private/etc/hosts") (literal "/private/etc/resolv.conf") (literal "/private/etc/services")
  (literal "/private/etc/protocols") (literal "/private/etc/passwd") (literal "/private/etc/group")
  (subpath "/private/etc/ssl") (literal "/private/etc/localtime")
  (literal "/dev/null") (literal "/dev/zero") (literal "/dev/random") (literal "/dev/urandom") (literal "/dev/tty")
  (literal "/") (literal "/private") (literal "/private/var") (literal "/private/etc"))
(allow file-write-data (literal "/dev/null") (literal "/dev/tty"))
(allow file-ioctl (literal "/dev/tty") (literal "/dev/null"))
;; explicit denies (documentation of intent; deny default already covers them)
(deny file-read* file-write*
  (subpath "/tmp") (subpath "/private/tmp") (subpath "/private/var/tmp") (subpath "/var/tmp")
  (subpath "/Users") (subpath "/Volumes") (subpath "/private/var/folders")
  (subpath (param "AGENT_ROOT")))

;; metadata (no contents) of the folders above the turn's own paths: path traversal and realpath() lstat each of
;; them. Never a bare (allow file-read-metadata): that let a turn stat() any path on the Mac (other chats' files, the
;; server's data folder, the owner's home). SBPL cannot split a parameter into its parent folders, so the profile
;; computes them: (ancestors "/a/b/c") = ("/a/b" "/a" "/"). After the explicit denies, so it wins over them.
(define (ancestors p)
  (let loop ((i 1) (acc (list "/")))
    (cond ((>= i (string-length p)) acc)
          ((char=? (string-ref p i) #\/) (loop (+ i 1) (cons (substring p 0 i) acc)))
          (else (loop (+ i 1) acc)))))
(define (path-and-ancestors p) (cons p (ancestors p)))
(apply allow file-read-metadata
  (map literal (append (ancestors (param "CHAT_DIR")) (path-and-ancestors (param "ENGINE_DIR"))
                       (path-and-ancestors (param "BRIDGE")) (path-and-ancestors (param "TOOLS_SOCK")))))
;; the entries of / itself (/etc, /var, /tmp are links into /private; listing / is allowed above anyway)
(allow file-read-metadata (regex #"^/[^/]+$"))

;; the engine and the MCP bridge (after the denies: in dev the engine lives under /Users)
(allow file-read* (subpath (param "ENGINE_DIR")) (literal (param "BRIDGE")))

;; this turn's chat folder only (HOME, TMPDIR, .claude/, .codex/, .turn/ are inside it)
(allow file-read* file-write* (subpath (param "CHAT_DIR")))

;; --- network -----------------------------------------------------------------------------------------------------
(allow network-outbound
  (literal (param "TOOLS_SOCK"))
  (remote tcp (string-append "localhost:" (param "PROXY_PORT"))))

;; --- local-login (dev): the owner's own CLI login ---------------------------------------------------------------
(if (equal? (param "LOCAL_LOGIN") "1")
  (begin
    (allow file-read* file-write*
      (subpath (string-append (param "USER_HOME") "/.claude"))
      (regex (string-append "^" (regex-quote (param "USER_HOME")) "/\\.claude\\.json"))
      (subpath (string-append (param "USER_HOME") "/.codex")))
    (allow file-read*
      (subpath (string-append (param "USER_HOME") "/.local/share/claude"))
      (subpath (string-append (param "USER_HOME") "/.local/bin"))
      (subpath (string-append (param "USER_HOME") "/Library/Keychains"))
      (literal (string-append (param "USER_HOME") "/Library/Preferences/com.apple.security.plist"))
      (subpath "/Library/Keychains") (subpath "/private/var/db/mds"))
    (allow file-write* (subpath (string-append (param "USER_HOME") "/Library/Keychains")))
    (allow process-exec (literal "/usr/bin/security"))
    (allow mach-lookup
      (global-name "com.apple.SecurityServer") (global-name "com.apple.securityd.xpc")
      (global-name "com.apple.security.agent") (global-name "com.apple.secd") (global-name "com.apple.trustd")
      (global-name "com.apple.trustd.agent") (global-name "com.apple.ocspd")
      (global-name "com.apple.system.opendirectoryd.membership") (global-name "com.apple.mDNSResponder")
      (global-name "com.apple.dnssd.service") (global-name "com.apple.SystemConfiguration.configd")
      (global-name "com.apple.SystemConfiguration.DNSConfiguration") (global-name "com.apple.networkd")
      (global-name "com.apple.nehelper") (global-name "com.apple.nesessionmanager.content-filter")
      (global-name "com.apple.cfprefsd.daemon") (global-name "com.apple.cfprefsd.agent")
      (global-name "com.apple.CoreServices.coreservicesd") (global-name "com.apple.lsd.mapdb"))
    (allow ipc-posix-shm-read* (ipc-posix-name "com.apple.AppleDatabaseChanged"))
    (allow ipc-posix-shm (ipc-posix-name-prefix "apple.shm."))
    (allow network-outbound (remote tcp "*:443") (remote udp "*:53") (literal "/private/var/run/mDNSResponder"))
    (allow system-socket)))
