;; Team AX engine sandbox (design tab 2 "기본 ② 샌드박스", tab 6 root/engine.sb).
;; The parameters below are param references. mycel-launcher writes their values into a copy of this profile with a
;; random name (no -D: sandbox-exec's argv is readable by every process of the account); by hand / in tests:
;;   sandbox-exec -f engine.sb -D CHAT_DIR=<agent>/<chatId> -D AGENT_ROOT=<agent> -D ENGINE_DIR=<dir of engine>
;;                -D BRIDGE=<mycel-bridge> -D TOOLS_SOCK=<run/tools/tools.sock> -D PROXY_PORT=<port>
;;                -D LOCAL_LOGIN=0|1 -D USER_HOME=<home of the account running the engine>
;;                -D SESSION_DIR=<folder of this turn's session transcript: the chat folder, or with LOCAL_LOGIN=1
;;                   ~/.claude/projects/<chat folder slug>> <engine> ...
;; Allowed: the turn's chat folder (HOME, TMPDIR, CLAUDE_CONFIG_DIR, CODEX_HOME live in it), the engine and bridge
;; executables, system libraries, our tools socket, the local model proxy port.
;; Denied: everything else, in particular /tmp, /private/var/tmp, /Users, /Volumes, other chat folders. That includes
;; METADATA (stat/lstat/readlink: existence, size, mtime, mode): only the turn's own paths and the folders above them can
;; be stat()ed (security audit r1, os-layer #1), and not the agent root that holds every chat folder (r3). The kernel
;; resolves a path before the sandbox sees it, so a name that does not exist still answers ENOENT rather than EPERM:
;; only an exactly guessed name can be tested for existence.
;; LOCAL_LOGIN=1 (dev / owner's own subscription login, engine runs as the owner): additionally the few login files
;; of Claude Code / Codex in the owner's home (see the block at the end), the installed CLIs, the login keychain
;; (Security framework) and direct HTTPS to the vendor (there is no model proxy in this mode).
;; SBPL applies the LAST matching rule, so the broad denies come first and the narrow allows after them.
(version 1)
(deny default)
(import "system.sb")

;; --- processes -------------------------------------------------------------------------------------------------
(allow process-fork)
(allow process-exec
  (subpath (param "ENGINE_DIR"))
  (literal (param "BRIDGE")))
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow process-info-pidinfo process-info-setcontrol (target self))
;; system information (CPU count, OS version, memory ...) yes; the list of every process on the Mac no: it showed
;; other turns' engines. What the sandbox cannot stop (security audit r2, os-layer #1; even a bare (deny sysctl-read)
;; does not): one pid at a time (kern.proc.pid: name, uid) and another process's argv AND environment
;; (KERN_PROCARGS2; the kernel only checks the uid). So no argv or environment of a turn names its chat: the launcher
;; passes chat paths relative to the engine's working folder (the chat folder) and gives sandbox-exec these
;; parameters in a profile copy with a random name, not as -D arguments. Signals, cwd and open-file paths of other
;; processes stay closed (process-info*/signal: same sandbox or self only).
(allow sysctl-read)
(deny sysctl-read
  (sysctl-name "kern.proc.all") (sysctl-name "kern.proc.pgrp") (sysctl-name "kern.proc.session")
  (sysctl-name "kern.proc.tty") (sysctl-name "kern.proc.uid") (sysctl-name "kern.proc.ruid")
  (sysctl-name "kern.proc.lcid"))

;; --- files -------------------------------------------------------------------------------------------------------
;; system libraries, frameworks, dyld cache, certificates, time zones, locale
(allow file-read*
  (subpath "/usr/lib") (subpath "/usr/share") (subpath "/System") (subpath "/Library/Apple")
  (subpath "/private/var/db/timezone") (subpath "/private/var/db/dyld") (subpath "/Library/Preferences/Logging")
  (literal "/private/etc/hosts") (literal "/private/etc/resolv.conf") (literal "/private/etc/services")
  (literal "/private/etc/protocols") (literal "/private/etc/passwd") (literal "/private/etc/group")
  (subpath "/private/etc/ssl") (literal "/private/etc/localtime")
  (literal "/dev/null") (literal "/dev/zero") (literal "/dev/random") (literal "/dev/urandom") (literal "/dev/tty")
  (literal "/") (literal "/private") (literal "/private/var") (literal "/private/etc"))
(allow file-write-data (literal "/dev/null") (literal "/dev/tty"))
(allow file-ioctl (literal "/dev/tty") (literal "/dev/null"))
;; explicit denies (documentation of intent; deny default already covers them)
(deny file-read* file-write*
  (subpath "/tmp") (subpath "/private/tmp") (subpath "/private/var/tmp") (subpath "/var/tmp")
  (subpath "/Users") (subpath "/Volumes") (subpath "/private/var/folders")
  (subpath (param "AGENT_ROOT")))

;; metadata (no contents) of the folders above the turn's own paths: path traversal and realpath() lstat each of
;; them. Never a bare (allow file-read-metadata): that let a turn stat() any path on the Mac (other chats' files, the
;; server's data folder, the owner's home). SBPL cannot split a parameter into its parent folders, so the profile
;; computes them: (ancestors "/a/b/c") = ("/a/b" "/a" "/"). After the explicit denies, so it wins over them.
;; The chat folder's own parent, AGENT_ROOT, is NOT one of them (security audit r3, os-layer #1): every chat folder
;; is an entry of it, so its stat() told a turn how many chats the team has (APFS: st_size and st_nlink grow with
;; every entry) and, from st_mtime, the moment someone else's chat was created or deleted. Opening paths through it,
;; getcwd() and realpath() of RELATIVE paths still work; realpath() of an ABSOLUTE path in the chat folder now fails
;; (it stats every folder on the way). Engines get relative chat paths from the launcher (security audit r2), and
;; real Claude Code turns (with --resume) and Codex turns pass; Codex only logs that it cannot walk its (unwanted)
;; skills folder. See docs/DECISIONS.md.
(define (ancestors p)
  (let loop ((i 1) (acc (list "/")))
    (cond ((>= i (string-length p)) acc)
          ((char=? (string-ref p i) #\/) (loop (+ i 1) (cons (substring p 0 i) acc)))
          (else (loop (+ i 1) acc)))))
(define (path-and-ancestors p) (cons p (ancestors p)))
(apply allow file-read-metadata
  (map literal (append (ancestors (param "AGENT_ROOT")) (path-and-ancestors (param "ENGINE_DIR"))
                       (path-and-ancestors (param "BRIDGE")) (path-and-ancestors (param "TOOLS_SOCK")))))
;; the system entries of / (/etc, /var, /tmp are links into /private). Named one by one: a pattern for every entry
;; of / also answered stat() of /Users (when someone's home folder was added), /Volumes (which disks are mounted),
;; /Applications and /opt (security audit r3, os-layer #1). When the turn's own paths lie under /Users (dev), the
;; ancestor rule above opens /Users itself, nothing next to it.
(allow file-read-metadata
  (literal "/etc") (literal "/var") (literal "/tmp") (literal "/usr") (literal "/bin") (literal "/sbin")
  (literal "/dev") (literal "/System") (literal "/Library") (literal "/private"))

;; the engine and the MCP bridge (after the denies: in dev the engine lives under /Users)
(allow file-read* (subpath (param "ENGINE_DIR")) (literal (param "BRIDGE")))

;; this turn's chat folder only (HOME, TMPDIR, .claude/, .codex/, .turn/ are inside it)
(allow file-read* file-write* (subpath (param "CHAT_DIR")))

;; --- network -----------------------------------------------------------------------------------------------------
(allow network-outbound (literal (param "TOOLS_SOCK")))
;; PROXY_PORT=0: no model proxy (dev / local login talks to the vendor directly, see below)
(if (not (equal? (param "PROXY_PORT") "0"))
  (allow network-outbound (remote tcp (string-append "localhost:" (param "PROXY_PORT")))))

;; --- local-login (dev): the owner's own CLI login ---------------------------------------------------------------
;; Only what the two CLIs were seen to need (security audit r1, os-layer #2), NOT the owner's whole ~/.claude and
;; ~/.codex: those hold the owner's other Claude Code / Codex sessions (transcripts of every project, history.jsonl,
;; file-history), the live-session registry with its messaging keys (~/.claude/sessions), and settings, hooks,
;; skills, plugins and config.toml that the owner's own unsandboxed CLIs load (writing them = escaping the sandbox).
;; SESSION_DIR: this turn's ~/.claude/projects/<chat folder slug>/ (the launcher passes it; Claude keeps the session
;; transcript there in this mode). Codex's CODEX_HOME is in the chat folder and links to ~/.codex/auth.json; the Codex
;; paths open only with LOCAL_CODEX=1 (a Codex binary is configured: office mode turns Codex off, security round 4).
(if (equal? (param "LOCAL_LOGIN") "1")
  (let* ((home (param "USER_HOME"))
         (in-home (lambda (p) (string-append home p))))
    (apply allow file-read-metadata
      (map literal (append (path-and-ancestors (in-home "/.claude"))
                           (ancestors (in-home "/.local/share/claude")) (ancestors (in-home "/Library/Keychains/-"))
                           (ancestors (in-home "/Library/Preferences/-")) (ancestors (param "SESSION_DIR")))))
    ;; Claude Code: ~/.claude.json and only its real siblings (.lock, .tmp.<pid>.<time> of its atomic write, .backup*),
    ;; its backups, this turn's session folder, read-only settings.json (it reads it even with --setting-sources "")
    ;; and the model catalog cache. The name is anchored at both ends: an open prefix let a turn create any
    ;; ~/.claude.json<anything> file, a store every other chat's turn could read (security round 4).
    (allow file-read* file-write*
      (regex (string-append "^" (regex-quote home) "/\\.claude\\.json(\\.lock|\\.tmp\\.[^/]+|\\.backup[^/]*)?$"))
      (subpath (in-home "/.claude/backups"))
      (subpath (param "SESSION_DIR")))
    (allow file-read* (literal (in-home "/.claude/settings.json")) (subpath (in-home "/.claude/cache")))
    ;; Codex: the login and the installed CLI, only when Codex is on
    (if (equal? (param "LOCAL_CODEX") "1")
      (begin
        (apply allow file-read-metadata (map literal (path-and-ancestors (in-home "/.codex"))))
        (allow file-read* file-write* (literal (in-home "/.codex/auth.json")))
        (allow file-read* (subpath (in-home "/.codex/packages")))))
    ;; the installed CLI (no secrets) and the login keychain. The Security framework reads it in-process and rewrites
    ;; login.keychain-db atomically when the CLI refreshes its token (.sb-* temp file renamed over it, -shm/-wal/-journal,
    ;; the .fl* lock): only those names are writable, so a turn cannot create other files there, make folders or move
    ;; the keychain away (it can still read and overwrite login.keychain-db itself: security round 4, documented).
    (allow file-read*
      (subpath (in-home "/.local/share/claude"))
      (subpath (in-home "/Library/Keychains"))
      (literal (in-home "/Library/Preferences/com.apple.security.plist"))
      (subpath "/Library/Keychains") (subpath "/private/var/db/mds"))
    (allow file-write* (regex (string-append "^" (regex-quote home) "/Library/Keychains/(login\\.keychain-db(-shm|-wal|-journal|\\.sb-[0-9a-f]+-[A-Za-z0-9]+)?|\\.fl[0-9A-F]+)$")))
    (allow process-exec (literal "/usr/bin/security"))
    (allow mach-lookup
      (global-name "com.apple.SecurityServer") (global-name "com.apple.securityd.xpc")
      (global-name "com.apple.security.agent") (global-name "com.apple.secd") (global-name "com.apple.trustd")
      (global-name "com.apple.trustd.agent") (global-name "com.apple.ocspd")
      (global-name "com.apple.system.opendirectoryd.membership") (global-name "com.apple.mDNSResponder")
      (global-name "com.apple.dnssd.service") (global-name "com.apple.SystemConfiguration.configd")
      (global-name "com.apple.SystemConfiguration.DNSConfiguration") (global-name "com.apple.networkd")
      (global-name "com.apple.nehelper") (global-name "com.apple.nesessionmanager.content-filter")
      (global-name "com.apple.cfprefsd.daemon") (global-name "com.apple.cfprefsd.agent")
      (global-name "com.apple.CoreServices.coreservicesd") (global-name "com.apple.lsd.mapdb"))
    (allow ipc-posix-shm-read* (ipc-posix-name "com.apple.AppleDatabaseChanged"))
    (allow ipc-posix-shm (ipc-posix-name-prefix "apple.shm."))
    (allow network-outbound (remote tcp "*:443") (remote udp "*:53") (literal "/private/var/run/mDNSResponder"))
    (allow system-socket)))

;; --- last: the agent root ---------------------------------------------------------------------------------------
;; Its metadata stays closed whatever an ancestor rule above opened (an engine, bridge or tools socket placed under
;; it; with LOCAL_LOGIN=1 a session folder that is the chat folder itself). Only the folder itself: the turn's own
;; chat folder inside it is a different path and stays allowed.
(deny file-read-metadata (literal (param "AGENT_ROOT")))

;; --- Codex lockdown files (last: wins over the chat folder and SESSION_DIR allows above) -------------------------
;; The Codex files that change what the engine may do (design tab 2 "엔진 잠금 (Codex CLI)"): a config.toml,
;; a models_cache.json (its shell_type decides whether the model gets a shell), skills and plugins written by a turn
;; would be read by the same CLI; so would a changed catalog.json (dev: the server's per-turn copy of the locked catalog).
;; Every setting travels as -c and the catalog is written by the server (dev) or lives in the engine folder (production),
;; so Codex never needs to write them; it only logs that the cache / bundled skills could not be written.
(deny file-write*
  (literal (string-append (param "CHAT_DIR") "/.codex/config.toml"))
  (literal (string-append (param "CHAT_DIR") "/.codex/models_cache.json"))
  (literal (string-append (param "CHAT_DIR") "/.codex/catalog.json"))
  (subpath (string-append (param "CHAT_DIR") "/.codex/skills"))
  (subpath (string-append (param "CHAT_DIR") "/.codex/plugins"))
  (literal (string-append (param "CHAT_DIR") "/.codex/AGENTS.md"))
  (literal (string-append (param "CHAT_DIR") "/.codex/hooks.json")))
