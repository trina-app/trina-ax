;; Sandbox of the self-hosted release Mac runner (docs/RELEASE-CI.md 13). Installed root-owned as
;; /Library/TrinaCI/runner.sb; /Library/TrinaCI/run.sh starts the runner (and so every job step, which inherits it) with
;;   sandbox-exec -f /Library/TrinaCI/runner.sb ./run.sh
;; The runner account _trinaci already has no permission on other users' homes (its own group, not staff, plus a deny
;; ACL on the owner's home). This adds what file permissions cannot express on a Mac shared with other work:
;;   - no file access under /Users at all, and under /Volumes only its own volume /Volumes/TrinaCI;
;;   - no connections to Unix sockets in /tmp, /private/var/tmp or /Users (local databases, dev servers' sockets);
;;   - no TCP/UDP to localhost (browsers' debugging ports, local servers, agents). pf (pf.anchor) also blocks the
;;     machine's own LAN addresses and private networks for this account, which a sandbox cannot name.
;; Everything else stays allowed (Xcode, codesign, security, hdiutil, notarytool over HTTPS), as a release build needs.
;; SBPL applies the LAST matching rule: the denies first, the narrow allows after them.
(version 1)
(allow default)

(deny file-read* file-write* (subpath "/Users"))
(allow file-read-metadata (literal "/Users"))

(deny file-read* file-write* (subpath "/Volumes"))
(allow file-read-metadata (literal "/Volumes"))
(allow file-read* file-write* (subpath "/Volumes/TrinaCI"))

(deny network-outbound (remote unix-socket (subpath "/private/tmp")))
(deny network-outbound (remote unix-socket (subpath "/private/var/tmp")))
(deny network-outbound (remote unix-socket (subpath "/Users")))
(deny network-outbound (remote ip "localhost:*"))
