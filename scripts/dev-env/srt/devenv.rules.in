// Trina dev environment (srt runner): the server account may start, stop and limit its own runs, nothing else. A run is
// an instance of the root-installed template trina-dev@.service (User= and Slice= are fixed there). StartUnit,
// StopUnit, ResetFailedUnit and SetUnitProperties send polkit the unit name and the verb on systemd 255 and 257.
// set-property on a unit that is not transient changes only cgroup values (memory, CPU, tasks), never User= or
// ExecStart=. Never a transient unit: StartTransientUnit could set User=root. Written by install-srt.sh.
polkit.addRule(function (action, subject) {
  if (action.id !== "org.freedesktop.systemd1.manage-units" || subject.user !== "@SRV_USER@") return;
  var unit = action.lookup("unit") || "", verb = action.lookup("verb") || "";
  if (/^trina-dev@[a-z0-9]{16}\.service$/.test(unit) && (verb === "start" || verb === "stop" || verb === "reset-failed" || verb === "set-property")) return polkit.Result.YES;
});
