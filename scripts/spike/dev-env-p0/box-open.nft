# Rules for an "open" box, loaded into the box's own network namespace (box.sh start). The box gets the internet;
# it never gets the host, the team server, the LAN, link-local / cloud metadata, or mail ports. Model calls do not
# use the network: they go through a unix socket per box (/run/trina/model.sock).
flush ruleset
table inet trina_box {
  set private4 {
    type ipv4_addr; flags interval
    elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24,
                 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 }
  }
  set private6 {
    type ipv6_addr; flags interval
    elements = { ::/128, ::1/128, ::ffff:0:0/96, 64:ff9b::/96, fc00::/7, fe80::/10, ff00::/8 }
  }
  chain output {
    type filter hook output priority 0; policy accept;
    oif "lo" accept
    # DNS only to pasta's forwarder (169.254.1.1 = podman's --dns-forward address)
    ip daddr 169.254.1.1 meta l4proto { udp, tcp } th dport 53 accept
    ip daddr @private4 counter reject with icmp admin-prohibited
    ip6 daddr @private6 counter reject with icmpv6 admin-prohibited
    # the team server's own public address goes here too (P1: filled in from the server's addresses)
    meta l4proto tcp tcp dport { 25, 465, 587 } counter reject with tcp reset
  }
}
