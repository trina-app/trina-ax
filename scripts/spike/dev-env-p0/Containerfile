# The dev box image: Debian 13 slim + node/npm, python3/venv/pip, git. No AI engine inside: Claude Code is downloaded
# at install time with a pinned SHA-256 (scripts/linux/engines.lock.json) and mounted read-only (box.sh).
FROM docker.io/library/debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm python3 python3-venv python3-pip git \
      ca-certificates curl procps less openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /work /cache /opt/claude /opt/trina /run/trina
# HOME and every cache live in the box volume (/cache), so the image stays read-only
ENV HOME=/cache/home npm_config_cache=/cache/npm PIP_CACHE_DIR=/cache/pip XDG_CACHE_HOME=/cache/xdg \
    PATH=/opt/claude:/usr/local/bin:/usr/bin:/bin
WORKDIR /work
