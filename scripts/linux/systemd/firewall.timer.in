# Re-applies the engine firewall every 30 seconds (spec 3.2.1): another tool (nft flush ruleset, ufw/firewalld reload,
# docker) may remove our table. Until then the launcher refuses turns: it tests the live rules before every turn
# (QA TC-310) and refuses when run/firewall.json is older than 10 minutes.
[Unit]
Description=Re-apply the Team AX engine firewall (@ID@)
[Timer]
OnBootSec=30s
OnUnitActiveSec=30s
AccuracySec=10s
Unit=@ID@-firewall.service
[Install]
WantedBy=timers.target
