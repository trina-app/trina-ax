    "srt": {
      "install": "on-request",
      "for": "the dev environment on srt (install-srt.sh, the image with --srt): node in /opt/trina/node, srt in /opt/trina/srt/<version>",
      "artifacts": ["node", "srt"]
    },
    "boxes": {
      "install": "on-request",
      "for": "the dev environment trial on podman boxes (scripts/dev-env/install-trial.sh)",
      "packages": {
        "podman": "",
        "crun": "",
        "passt": "",
        "uidmap": "",
        "nftables": "",
        "conntrack": "",
        "dbus-user-session": "",
