        "libxdamage1": "",
        "libxext6": "",
        "libxfixes3": "",
        "libxkbcommon0": "",
        "libxrandr2": "",
        "libfontconfig1": "",
        "libglib2.0-0": { "on": ["debian-12"] },
        "libatk1.0-0": { "on": ["debian-12"] },
        "libatspi2.0-0": { "on": ["debian-12"] },
        "libatk-bridge2.0-0": { "on": ["debian-12"] },
        "libasound2": { "on": ["debian-12"] },
        "libglib2.0-0t64": { "on": ["debian-13", "ubuntu-24.04"] },
        "libatk1.0-0t64": { "on": ["debian-13", "ubuntu-24.04"] },
        "libatspi2.0-0t64": { "on": ["debian-13", "ubuntu-24.04"] },
        "libatk-bridge2.0-0t64": { "on": ["debian-13", "ubuntu-24.04"] },
        "libasound2t64": { "on": ["debian-13", "ubuntu-24.04"] }
      },
      "artifacts": ["chrome-headless-shell"]
    },
    "google-apps": {
      "install": "default",
      "for": "Gmail, Google Calendar, Docs and Sheets for the AI (server/src/integrations/google-apps/library.ts): the Google Workspace MCP library, run by the server on 127.0.0.1",
      "packages": {
        "python3": ">=3.11",
        "python3-venv": ""
      },
      "python": ["workspace-mcp"]
    },
    "image": {
      "install": "on-request",
      "for": "the hosted team VM (scripts/image/customize.sh): guest agent, time, zram, security updates, no SSH server",
      "packages": {
        "systemd": "",
        "systemd-sysv": "",
