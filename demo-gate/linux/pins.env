# Downloaded programs of the Linux demo host (amd64), with the sha256 of each file. stage.sh downloads and checks them;
# install.sh checks them again before it puts them in /opt/trina-demo. chrome-headless-shell is not here: it is the
# pinned one of scripts/system/packages.json (the same file every Linux install uses).
# node: the gate's runtime (Node 24+; the same 26 as the Mac host). sha256 from nodejs.org SHASUMS256.txt
NODE_VERSION=26.12.1
NODE_URL=https://nodejs.org/dist/v26.12.1/node-v26.12.1-linux-x64.tar.xz
NODE_SHA256=6170b2d474e1c626f43cff3adc118df9fe3b573258a4fc3d850c8dbc6b079bbd
# bun: the instances' and the snapshot builder's runtime (the Mac host's). sha256 from the release's SHASUMS256.txt
BUN_VERSION=1.4.4
BUN_URL=https://github.com/oven-sh/bun/releases/download/bun-v1.4.4/bun-linux-x64.zip
BUN_SHA256=bf8ccbfb2b0b80159e0f9a6d15c55317add8077534dbc6130a3edb52fccb395c
# Claude Code: the instances' engine and the credential user's login. sha256 from the release's manifest.json
CLAUDE_VERSION=2.1.328
CLAUDE_URL=https://storage.googleapis.com/claude-code-dist-86c565f3-f756-42ad-8dfa-d59b1c096819/claude-code-releases/2.1.328/linux-x64/claude
CLAUDE_SHA256=a982d38030b97e750848add2cbb2df6d9a70d5544a22ca9b216a349ba25865e8
# cloudflared: the tunnel. sha256 is the GitHub release asset's digest
CLOUDFLARED_VERSION=2026.11.1
CLOUDFLARED_URL=https://github.com/cloudflare/cloudflared/releases/download/2026.11.1/cloudflared-linux-amd64
CLOUDFLARED_SHA256=97bb3b02d23a5980fc9c15a1a270e692da1923f103f920d5b16d4931d5ab55e7
