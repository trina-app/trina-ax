#!/bin/sh
# Nightly rebuild of the free-roam snapshots (root; trina-demo-snapshots.timer). The builder runs as tdbuild (the nft
# table allows it loopback only), the canary's file scan runs on each new snapshot, and only a clean snapshot is moved
# into the gate's folder. Build output and snapshots are on the instances' XFS file system (/srv/tdg), so the move is
# a rename and the gate's clone is a reflink. The gate's sweeper removes older snapshots.
#   TD_LOCALES="en ko" tdsnap-rebuild      only some languages (default: all six)
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
U=tdbuild
APP=/opt/trina-demo/app
BUN=/opt/trina-demo/bin/bun
OUT=/srv/tdg/.build
SNAP=/srv/tdg/.snapshots
SEALED=/etc/trina-demo/canary-sealed
HOMEDIR=/var/demo-build
LOCALES=${TD_LOCALES:-en ko ja zh es id}
log(){ echo "$(date -u +%FT%TZ) $*"; }
mountpoint -q /srv/tdg || { log "/srv/tdg is not mounted: nothing built"; exit 1; }
[ -r "$SEALED" ] || { log "$SEALED missing: nothing built (the canary needs it)"; exit 1; }
install -d -o $U -g $U -m 700 "$OUT" "$OUT/tmp"
as_builder() { runuser -u $U -- env -i HOME=$HOMEDIR TMPDIR=$OUT/tmp PATH=/opt/trina-demo/bin:/usr/bin:/bin LANG=C.UTF-8 /bin/sh -c 'cd /opt/trina-demo/app && exec "$@"' sh "$@"; }
rc=0
for l in $LOCALES; do
  rm -rf "${OUT:?}/$l"
  if ! as_builder "$BUN" scripts/demo/free-roam/build-snapshot.ts --content steepling --locale "$l" --out "$OUT" >"$OUT/build-$l.log" 2>&1; then
    log "$l: build failed (see $OUT/build-$l.log)"; rc=1; continue
  fi
  n=$(ls "$OUT/$l" 2>/dev/null | tail -1)
  [ -n "$n" ] || { log "$l: no snapshot written"; rc=1; continue; }
  if ! as_builder "$BUN" scripts/demo/free-roam/canary.ts --sealed "$SEALED" --snapshot "$OUT/$l/$n" >"$OUT/canary-$l.log" 2>&1; then
    log "$l: canary found a sealed string, snapshot $n NOT used (see $OUT/canary-$l.log)"; rc=1; continue
  fi
  install -d -o tdgate -g tdrun -m 750 "$SNAP/$l"
  chown -R tdgate:tdrun "$OUT/$l/$n" && chmod -R g+rX,g-w,o-rwx "$OUT/$l/$n" && mv "$OUT/$l/$n" "$SNAP/$l/$n" && log "$l: snapshot $n in place"
done
exit $rc
