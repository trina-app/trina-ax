#!/bin/sh
# Runs as tdgate (sudo -u tdgate, /etc/sudoers.d/trina-demo; tdcred-credsync or a person). Reads ONE token line on
# stdin and puts it into the gate's AI credential file (0600) when it changed. Never prints the token.
set -eu
umask 077
PATH=/usr/bin:/bin
dest=/var/demo-gate/secrets/ai-credential
[ "$(id -un)" = "tdgate" ] || { echo "must run as tdgate" >&2; exit 2; }
tok=$(head -c 4096 | tr -d '\r\n')
case "$tok" in
  sk-ant-oat01-*|sk-ant-api03-*) ;;
  *) echo "refused: not a Claude token" >&2; exit 3 ;;
esac
case "$tok" in *[!A-Za-z0-9_-]*) echo "refused: unexpected characters" >&2; exit 3 ;; esac
if [ -f "$dest" ] && [ "$(cat "$dest")" = "$tok" ]; then echo "unchanged"; exit 0; fi
tmp=$(mktemp /var/demo-gate/secrets/.ai-credential.XXXXXX)
printf '%s\n' "$tok" > "$tmp"
chmod 600 "$tmp"
mv -f "$tmp" "$dest"
echo "updated"
