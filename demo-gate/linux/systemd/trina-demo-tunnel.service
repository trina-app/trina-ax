# The Cloudflare tunnel of the demo host (one connector of one named tunnel; README "Hosting on Linux": never add a
# second connector to a tunnel that already serves the live hostname from another machine).
[Unit]
Description=Trina demo tunnel (cloudflared)
After=network-online.target trina-demo-nft.service
Wants=network-online.target

[Service]
User=tdtunnel
Group=tdtunnel
WorkingDirectory=/var/demo-tunnel
Environment=HOME=/var/demo-tunnel
ExecStartPre=+/opt/trina-demo/bin/tdnft-load
ExecStart=/opt/trina-demo/bin/cloudflared --no-autoupdate --config /var/demo-tunnel/config.yml tunnel run
UMask=0077
Restart=always
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/demo-tunnel
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
MemoryMax=512M
# a backstop for the nft table: loopback and the Cloudflare edge only
IPAddressDeny=any
IPAddressAllow=localhost 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
