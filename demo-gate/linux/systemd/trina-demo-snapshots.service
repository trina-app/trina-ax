[Unit]
Description=Trina free-roam demo snapshots (nightly rebuild)
After=network-online.target trina-demo-nft.service
RequiresMountsFor=/srv/tdg

[Service]
Type=oneshot
ExecStartPre=/opt/trina-demo/bin/tdnft-load
ExecStart=/opt/trina-demo/bin/tdsnap-rebuild
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
