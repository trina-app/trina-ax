# Dev environment on srt: the attack suite (tests/linux/srt-attack.ts, docs/research/srt-dev-env.md 10.2).
# Debian 13 with what install-srt.sh puts on a team server: bubblewrap, socat, ripgrep, node 22 in /opt/trina/node, srt
# from scripts/dev-env/srt/package-lock.json in /opt/trina/srt/<version>, run-wrap in /opt/trina/devenv. No systemd: the
# driver runs srt with no scope (memory, CPU, polkit and systemd lines run on the VM). Run it with tests/linux/srt-run.ts
# (--privileged: bwrap's user namespaces and mounts). The same image runs tests/linux/srt-subagent.ts (sub-agents' and
# skills' commands through the real box_shell tool), in a container of its own, and tests/linux/srt-work-write.ts (the
# server's safe write into a work folder) in a third.
FROM oven/bun:1.3.12-debian
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap socat ripgrep curl xz-utils ca-certificates \
    python3 git procps util-linux \
 && rm -rf /var/lib/apt/lists/*
# node 22 (srt needs 22.12 or later; NODE_USE_ENV_PROXY needs 22.21), the node of scripts/system/packages.json (a test compares them)
RUN case "$TARGETARCH" in \
      amd64) A=x64; S=1805bcd35e6815559bd2eb97db438d3fdb0eb3a5e6a977b7c1badca76337e9ce ;; \
      arm64) A=arm64; S=6287aa46b6c375d816e63ae66d024fbbfd70404825aabdfdf898a970871d2f4b ;; \
      *) echo "no node pin for $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/node.tar.xz https://nodejs.org/dist/v22.23.4/node-v22.23.4-linux-$A.tar.xz \
 && echo "$S  /tmp/node.tar.xz" | sha256sum -c - \
 && mkdir -p /opt/trina && tar -xJf /tmp/node.tar.xz -C /opt/trina && mv /opt/trina/node-v22.23.4-linux-$A /opt/trina/node-v22.23.4 \
 && chown -R root:root /opt/trina/node-v22.23.4 && chmod -R go-w /opt/trina/node-v22.23.4 \
 && ln -s /opt/trina/node-v22.23.4 /opt/trina/node && rm /tmp/node.tar.xz
COPY scripts/dev-env/srt/package.json scripts/dev-env/srt/package-lock.json /opt/trina/srt/0.0.81/
RUN cd /opt/trina/srt/0.0.81 && PATH=/opt/trina/node/bin:$PATH npm ci --ignore-scripts --omit=dev --no-audit --no-fund >/dev/null \
 && ln -s node_modules/@anthropic-ai/sandbox-runtime/dist/cli.js cli.js && rm -rf /root/.npm \
 && test "$(/opt/trina/node/bin/node cli.js --version)" = 0.0.81
COPY scripts/dev-env/srt/srt-full.mjs /opt/trina/srt/0.0.81/full.mjs
COPY scripts/dev-env/srt/run-wrap /opt/trina/devenv/run-wrap
# the libraries a run has without pip or npm install, from the list (tests/linux/box-libs-install.sh; attacks LIB1-LIB3)
COPY scripts/system/packages.sh scripts/system/packages.json /tmp/box-libs/system/
COPY scripts/dev-env/srt/node-libs.package.json scripts/dev-env/srt/node-libs.package-lock.json /tmp/box-libs/srt/
COPY tests/linux/box-libs-install.sh /tmp/box-libs/
RUN bash /tmp/box-libs/box-libs-install.sh /tmp/box-libs && rm -rf /tmp/box-libs
RUN chmod 755 /opt/trina/devenv/run-wrap && chmod -R go-w /opt/trina \
 && useradd --system -m -U -s /usr/sbin/nologin axserver && chmod 700 /home/axserver
COPY package.json bun.lock /opt/mycel/
COPY shared /opt/mycel/shared
COPY server/package.json /opt/mycel/server/package.json
COPY tests/package.json /opt/mycel/tests/package.json
COPY web/package.json /opt/mycel/web/package.json
COPY desktop/package.json /opt/mycel/desktop/package.json
COPY relay/package.json /opt/mycel/relay/package.json
RUN cd /opt/mycel && bun install --frozen-lockfile --ignore-scripts >/dev/null
# the whole server and the test helpers: tests/linux/srt-subagent.ts runs the real box_shell tool and runner on srt
COPY server/src /opt/mycel/server/src
COPY server/migrations /opt/mycel/server/migrations
COPY server/assets /opt/mycel/server/assets
COPY resources /opt/mycel/resources
COPY tests/lib /opt/mycel/tests/lib
COPY tests/linux/srt-attack.ts tests/linux/srt-subagent.ts tests/linux/srt-work-write.ts tests/linux/sweep-as.ts /opt/mycel/tests/linux/
CMD ["bun", "/opt/mycel/tests/linux/srt-attack.ts"]
