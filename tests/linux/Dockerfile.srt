# Dev environment on srt: the attack suite (tests/linux/srt-attack.ts, docs/research/srt-dev-env.md 10.2).
# Debian 13 with what install-srt.sh puts on a team server: bubblewrap, socat, ripgrep, node 22 in /opt/trina/node, srt
# from scripts/dev-env/srt/package-lock.json in /opt/trina/srt/<version>, run-wrap in /opt/trina/devenv. No systemd: the
# driver runs srt with no scope (memory, CPU, polkit and systemd lines run on the VM). Run it with tests/linux/srt-run.ts
# (--privileged: bwrap's user namespaces and mounts).
FROM oven/bun:1.3.12-debian
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap socat ripgrep curl xz-utils ca-certificates \
    python3 git procps util-linux \
 && rm -rf /var/lib/apt/lists/*
# node 22 (srt needs 22.12 or later), pinned as in scripts/dev-env/srt/install-srt.sh
RUN case "$TARGETARCH" in \
      amd64) A=x64; S=00bbd05e306ea68b6e13e17360d0e2f680b493ef95f2fea1c4296ff7437530bc ;; \
      arm64) A=arm64; S=06907b9c088ce62305bc1530e5c1ae1510245114645768f7750c349c5b6fe667 ;; \
      *) echo "no node pin for $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/node.tar.xz https://nodejs.org/dist/v22.20.0/node-v22.20.0-linux-$A.tar.xz \
 && echo "$S  /tmp/node.tar.xz" | sha256sum -c - \
 && mkdir -p /opt/trina && tar -xJf /tmp/node.tar.xz -C /opt/trina && mv /opt/trina/node-v22.20.0-linux-$A /opt/trina/node-v22.20.0 \
 && ln -s /opt/trina/node-v22.20.0 /opt/trina/node && rm /tmp/node.tar.xz
COPY scripts/dev-env/srt/package.json scripts/dev-env/srt/package-lock.json /opt/trina/srt/0.0.81/
RUN cd /opt/trina/srt/0.0.81 && PATH=/opt/trina/node/bin:$PATH npm ci --ignore-scripts --omit=dev --no-audit --no-fund >/dev/null \
 && ln -s node_modules/@anthropic-ai/sandbox-runtime/dist/cli.js cli.js && rm -rf /root/.npm \
 && test "$(/opt/trina/node/bin/node cli.js --version)" = 0.0.81
COPY scripts/dev-env/srt/run-wrap /opt/trina/devenv/run-wrap
RUN chmod 755 /opt/trina/devenv/run-wrap && chmod -R go-w /opt/trina \
 && useradd --system -m -U -s /usr/sbin/nologin axserver && chmod 700 /home/axserver
COPY package.json bun.lock /opt/mycel/
COPY shared /opt/mycel/shared
COPY server/package.json /opt/mycel/server/package.json
COPY tests/package.json /opt/mycel/tests/package.json
COPY web/package.json /opt/mycel/web/package.json
COPY desktop/package.json /opt/mycel/desktop/package.json
COPY relay/package.json /opt/mycel/relay/package.json
RUN cd /opt/mycel && bun install --frozen-lockfile --ignore-scripts >/dev/null
COPY server/src/devenv/srt /opt/mycel/server/src/devenv/srt
COPY tests/linux/srt-attack.ts /opt/mycel/tests/linux/srt-attack.ts
CMD ["bun", "/opt/mycel/tests/linux/srt-attack.ts"]
