# Copy to .env next to docker-compose.yml. Keep .env private if it holds a tunnel token.

# The release to run: the latest stable one (marked Latest on https://github.com/trina-app/trina-ax/releases).
# Change it to update.
TRINA_AX_VERSION=0.4.0

# Engines: claude, codex or "claude codex"
TRINA_AX_ENGINES=claude

# Host address and port of the web app. 127.0.0.1 = this machine only (use an SSH tunnel from your computer).
TRINA_AX_BIND=127.0.0.1
TRINA_AX_PORT=47820

# Team time zone for the first run (IANA name)
#TRINA_AX_TIMEZONE=Asia/Seoul

# Limits for the whole team server (memory also limits swap)
TRINA_AX_MEMORY=4g
TRINA_AX_CPUS=2

# Public https address through Cloudflare Tunnel (docker compose --profile tunnel up -d)
#TRINA_AX_PUBLIC_HOST=team.example.com
#CLOUDFLARE_TUNNEL_TOKEN=
